# =========================================================================
# JRS MEDIBRIDGE - PRODUCTION ENVIRONMENT CONFIGURATION
# =========================================================================

# Server Port & Runtime Mode
PORT=8080
ENVIRONMENT=production

# Public Deployed Live Links (Cloudflare Zero-Trust Tunnel)
PUBLIC_URL=https://lodging-ever-screen-shaved.trycloudflare.com
ADMIN_URL=https://lodging-ever-screen-shaved.trycloudflare.com/admin.html
LOCAL_URL=http://localhost:8080

# Google Gemini AI Clinical Intelligence API Key
# Set your Gemini API key here (supports gemini-2.0-flash & gemini-1.5-flash)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# Database & Hospital Routing
DATABASE_PATH=database.db
HOSPITAL_NODE=BOM10_MUMBAI
MCI_COMPLIANCE=TRUE
